# Copy this file to .env. Shell environment variables take precedence.
# Choose a model available to your API account and fill in its key.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048
# Approximate input budget; the current user prompt is never silently dropped.
LLM_CONTEXT_BUDGET=6000
LLM_STREAM=false
# false: independent requests for multiple candidates, compatible with all backends.
# true: send n to a backend/model that explicitly supports it.
LLM_SUPPORTS_N=false
LLM_TOKEN_LIMIT_PARAM=max_tokens
# Leave unset to preserve GenSim's stage temperatures; null omits temperature.
# LLM_TEMPERATURE=0
LLM_EXTRA_BODY={}

# DeepSeek example (replace the active values above):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# Qwen / Alibaba Cloud Beijing example; use your workspace and matching region key:
# LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_EXTRA_BODY='{"enable_thinking":false}'
# Some thinking models require LLM_STREAM=true.
# Set LLM_TOKEN_LIMIT_PARAM=max_completion_tokens for models requiring that field.
